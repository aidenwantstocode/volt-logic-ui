# =========================================================
# VOLT-LOGIC Backend Environment Configuration
# =========================================================

# Database Configuration (PostgreSQL / Supabase / Neon / Local Postgres)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Example Local Postgres: postgresql://postgres:postgres@localhost:5432/volt_logic
# Default fallback to sqlite:///./volt_logic.db for zero-infra local demo
DATABASE_URL=sqlite:///./volt_logic.db

# ML Model API Key (Place your API key here for external ML services or custom model endpoints)
ML_MODEL_API_KEY=your-ml-model-api-key-here
EXTERNAL_ML_ENDPOINT=

# Security & CORS Settings (Comma-separated origins for production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Rate Limiting (slowapi format)
RATE_LIMIT_PREDICT=20/minute
RATE_LIMIT_HISTORY=30/minute
RATE_LIMIT_DEFAULT=60/minute

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
MODEL_VERSION=v1.0.0-tabular
